#!/usr/bin/env perl
#
# Check a release ZIP against the tree it was built from: its checksum
# file, its single top-level directory, the required files, the headers
# and library byte for byte, and a passing audit.
#
# usage: scripts/check-dist libc16-VERSION.zip VERSION

use v5.36;
use Digest::SHA qw(sha256_hex);
use File::Basename qw(basename);
use File::Find qw(find);
use IO::Uncompress::Unzip qw($UnzipError);

@ARGV == 2 or die "usage: $0 libc16-VERSION.zip VERSION\n";
my ($zipfile, $version) = @ARGV;
my $top = "libc16-$version";
my $errors = 0;
sub bad ($msg) { say "not ok: $msg"; $errors++ }
sub slurp ($path) {
    open my $fh, '<:raw', $path or die "$path: $!\n";
    local $/;
    return <$fh>;
}

# The checksum file, in sha256sum format, names the ZIP by its base name.
my $zipdata = slurp($zipfile);
my $sum = slurp("$zipfile.sha256");
my $want = sha256_hex($zipdata) . '  ' . basename($zipfile) . "\n";
bad("$zipfile.sha256 does not match the ZIP") unless $sum eq $want;

my %entries;
my $z = IO::Uncompress::Unzip->new(\$zipdata) or die "$zipfile: $UnzipError\n";
for (my $status = 1; $status > 0; $status = $z->nextStream) {
    my $name = $z->getHeaderInfo->{Name};
    my $data = '';
    while (($status = $z->read(my $buf)) > 0) { $data .= $buf }
    die "$zipfile: $name: $UnzipError\n" if $status < 0;
    $entries{$name} = $data;
}

for my $name (sort keys %entries) {
    bad("$name is outside $top/") unless $name =~ m{^\Q$top\E/};
}
my %got = map { (s{^\Q$top\E/}{}r => $entries{$_}) } keys %entries;

my %libs = ('lib/LIBC16.LIB' => 'build/s/LIBC16.LIB', 'lib/LIBC16C.LIB' => 'build/c/LIBC16C.LIB',
            'lib/LIBC16L.LIB' => 'build/l/LIBC16L.LIB');
for my $f (sort(keys %libs), qw(VERSION LICENSE README.md BUILD.txt
              docs/ABI.md docs/DESIGN.md docs/LICENSE-PROVENANCE.md
              docs/CONSUMERS.md docs/AUDIT.txt tools/fetch-watcom)) {
    bad("$f is missing") unless exists $got{$f};
}
bad('VERSION is not ' . $version) unless ($got{VERSION} // '') eq "$version\n";
for my $f (sort keys %libs) {
    bad("$f differs from $libs{$f}") unless ($got{$f} // '') eq slurp($libs{$f});
}

# Exactly the public headers, unchanged.
my %hdrs;
find({ no_chdir => 1, wanted => sub { $hdrs{$_} = 1 if -f $_ } }, 'include');
for my $h (sort keys %hdrs) {
    bad("$h is missing or differs") unless ($got{$h} // "\0") eq slurp($h);
}
for my $f (grep { m{^include/} } sort keys %got) {
    bad("$f is not a public header") unless $hdrs{$f};
}

for my $f (sort keys %got) {
    bad("$f is unexpected")
        unless $f =~ m{^(VERSION|LICENSE|README\.md|BUILD\.txt|lib/LIBC16[CL]?\.LIB|
                         tools/fetch-watcom|include/.*\.h|docs/[^/]+\.(md|txt)|
                         docs/spec/[^/]+\.md)$}x;
}
bad('BUILD.txt does not name the source revision')
    unless ($got{'BUILD.txt'} // '') =~ /revision [0-9a-f]{40}/;
# A passing audit for each of the three libraries.
my @passed = ($got{'docs/AUDIT.txt'} // '') =~ /^control: .*\n(?:(?!^== ).*\n)*?^0 member\(s\) over/mg;
bad('docs/AUDIT.txt does not record a passing audit of each library') unless @passed == 3;

if ($errors) {
    say "$errors problem(s) in $zipfile";
    exit 1;
}
printf "ok %s: %d files, sha256 %s\n", basename($zipfile), scalar(keys %got),
    substr($sum, 0, 64);
